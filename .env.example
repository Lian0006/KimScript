# ============================================
# Self-hosted (Supabase + Postgres)
# ============================================

# Database (Postgres de tu stack self-hosted)
# Ejemplo Docker local:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Supabase (self-hosted) - API URL (no la del Studio)
# Ejemplo (Kong / API gateway):
# SUPABASE_URL=https://supabase.tudominio.com
SUPABASE_URL=http://127.0.0.1:8000

# Supabase Keys
# - ANON (public/publishable): segura para frontend
# - SERVICE_ROLE: SOLO backend (NO exponer al cliente)
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Client (Vite)
# ============================================

VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Backend API base URL usado por el frontend (opcional)
# Ejemplo local:
# VITE_API_URL=http://127.0.0.1:5000/api
VITE_API_URL=http://127.0.0.1:5000/api

# ============================================
# Mercado Pago (Suscripciones)
# ============================================
# PRUEBAS: pon aquí tu Access Token de prueba (empieza por TEST-)
# Producción: después cambia por el token de producción
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-from-panel
# Opcional: Public key de prueba (para frontend si la usas)
MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key-from-panel
# URL del frontend para redirección tras el pago
FRONTEND_URL=https://www.kimscript.com
# Si tu cuenta MP usa moneda local (ej. México): MXN y mínimo ej. 1600
# MERCADOPAGO_CURRENCY=MXN
# MERCADOPAGO_MIN_AMOUNT=1600
# MERCADOPAGO_USD_TO_LOCAL=17

# Application Configuration
NODE_ENV=production
PORT=5000
